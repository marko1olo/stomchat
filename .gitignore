# Одноразовые скрипты замеров и проб. Их вывод живёт в отчётах _fix_*.md и
# _recon_*.md, а сами скрипты — нет: часть из них открывает базы и пишет во
# временные копии НА УРОВНЕ МОДУЛЯ, а test_import_safety.py перебирает все *.py
# через os.listdir. Случайно закоммиченный такой файл становится тем же капканом,
# что patch_assistant.py: импорт портит рабочее состояние. Отчёты остаются в
# репозитории, инструменты замера — нет.
_probe_*.py
_measure_*.py
_sabotage_*.py
_smoke_*.py
# Бэкапы, которые агент делает перед саботажем. _bak_assistant_*.py — это полная
# копия боевого модуля рядом с ним: её видит os.listdir в test_import_safety, и
# любой её импорт даёт второй экземпляр модуля с собственным состоянием.
_bak_*.py
*.sabbak
_verify_*.py
_verify_*.txt
_skeptic_*.py
*.skepbak
*.fixedbak

# Вложенная ПОЛНАЯ КОПИЯ репозитория (981 МБ, свой .git, 167 .py) — её создал
# сторонний органайзер рабочего стола, когда переносил папку в _Organized.
# Проверено: это не junction, а отдельный каталог; HEAD у неё тот же, так что
# ничего уникального в коде там нет. Держим в игноре по двум причинам:
# 1) один `git add -A` иначе утащит в историю почти гигабайт;
# 2) rg от корня репозитория заходит внутрь и УДВАИВАЕТ любой замер по дереву —
#    на этом уже сбился подсчёт вхождений. Любой обход дерева ограничивать:
#    rg -g '!stomchat' -g '!uploaded_media' -g '!.git'
# Удалять её — решение владельца: рядом с кодом там лежат его же IMG_*.MOV и
# TITAN_PROMPTS, а они в репозитории нигде больше не встречаются.
/stomchat/
